        "approval_url": "https://console.example.com/agreements/approve?sku=caselaw-metered"
      },
      "note": "approval_url is the provider's checkout_url, or the deployment's own approval surface for provider 'internal'. The refusal SHOULD also be recorded as a quantity-0 requests meter event (13.5)."
    },
    "free_offering_case": {
      "offering": "not-covered-by-any-sku",
      "expect": "no AGREEMENT_REQUIRED - an offering covered by no SKU is free (19.1)"
    }
  },
  "rating": {
    "comment": "19.6: deterministic, replayable, integer-only. per_unit: charge = floor(quantity * amount_micro / per). package: ceil(quantity / size) * amount_micro over the period aggregate. tiered: each tier rates its own span, floor per tier. included deducts before rating. Refusals and unagreed events rate to zero. The budget ceiling clamps. Aggregation grain: consumer OWNER per UTC period.",
    "cases": [
      {
        "case": "flat",
        "price": {
          "model": "flat",
          "currency": "USD",
          "amount_micro": 20000
        },
        "events": [
          {
            "meter": "requests",
            "quantity": 1
          },
          {
            "meter": "requests",
            "quantity": 1
          },
          {
            "meter": "requests",
            "quantity": 1
          },
          {
            "meter": "requests",
            "quantity": 0,
            "refused": true
          }
        ],
        "expect_charge_micro": 60000,
        "why": "three delivered requests; the refusal rates to zero"
      },
      {
        "case": "per_unit_floor",
        "price": {
          "model": "per_unit",
          "currency": "USD",
          "meter": "tokens_out",
          "per": 1000,
          "amount_micro": 1500
        },
        "events": [
          {
            "meter": "tokens_out",
            "quantity": 4210
          }
        ],
        "expect_charge_micro": 6315,
        "why": "floor(4210 * 1500 / 1000) = 6315"
      },
      {
        "case": "per_unit_floor_partial",
        "price": {
          "model": "per_unit",
          "currency": "USD",
          "meter": "tokens_out",
          "per": 1000,
          "amount_micro": 1500
        },
        "events": [
          {
            "meter": "tokens_out",
            "quantity": 999
          }
        ],
        "expect_charge_micro": 1498,
        "why": "floor(999 * 1500 / 1000) = floor(1498.5) = 1498 - floor, EXT-8's convention, so no partial micro-unit is ever charged"
      },
      {
        "case": "package_ceil",
        "price": {
          "model": "package",
          "currency": "USD",
          "meter": "requests",
          "size": 100,
          "amount_micro": 250000,
          "period": "day"
        },
        "events": [
          {
            "meter": "requests",
            "quantity": 400
          },
          {
            "meter": "requests",
            "quantity": 330
          }
        ],
        "expect_charge_micro": 2000000,
        "why": "day aggregate 730; ceil(730/100) = 8 packages; 8 * 250000 = 2000000 - packages round UP, the one place rounding favours the seller, which is what buying by the package means"
      },
      {
        "case": "tiered_graduated",
        "price": {
          "model": "tiered",
          "currency": "USD",
          "meter": "tokens_out",
          "per": 1000,
          "period": "month",
          "tiers": [
            {
              "up_to": 100000,
              "amount_micro": 2000
            },
            {
              "up_to": 1000000,
              "amount_micro": 1500
            },
            {
              "amount_micro": 1000
            }
          ]
        },
        "events": [
          {
            "meter": "tokens_out",
            "quantity": 1250000
          }
        ],
        "expect_charge_micro": 1800000,
        "why": "tier1 100000 units -> floor(100000*2000/1000)=200000; tier2 900000 -> 1350000; tier3 250000 -> 250000; graduated, never volume"
      },
      {
        "case": "included_allowance_covers",
        "price": {
          "model": "per_unit",
          "currency": "USD",
          "meter": "tokens_out",
          "per": 1000,
          "amount_micro": 1500,
          "included": {
            "quantity": 10000,
            "period": "day"
          }
        },
        "events": [
          {
            "meter": "tokens_out",
            "quantity": 4210
          }
        ],
        "expect_charge_micro": 0,
        "why": "4210 within the day's 10000 included"
      },
      {
        "case": "included_allowance_exceeded",
        "price": {
          "model": "per_unit",
          "currency": "USD",
          "meter": "tokens_out",
          "per": 1000,
          "amount_micro": 1500,
          "included": {
            "quantity": 10000,
            "period": "day"
          }
        },
        "events": [
          {
            "meter": "tokens_out",
            "quantity": 12000
          }
        ],
        "expect_charge_micro": 3000,
        "why": "billable 2000 after the allowance; floor(2000*1500/1000)=3000"
      },
      {
        "case": "ceiling_clamps",
        "price": {
          "model": "per_unit",
          "currency": "USD",
          "meter": "tokens_out",
          "per": 1000,
          "amount_micro": 1500
        },
        "budget_cost_ceiling_micro": 5000,
        "events": [
          {
            "meter": "tokens_out",
            "quantity": 4210
          }
        ],
        "expect_charge_micro": 5000,
        "why": "computed 6315 exceeds the ceiling; rated 5000; the excess is the responder's own account (7.7 given mechanical teeth) - the ceiling composed with an agreed unit price is the consumer's hard bound on declared meters"
      },
      {
        "case": "no_agreement_no_charge",
        "price": {
          "model": "per_unit",
          "currency": "USD",
          "meter": "tokens_out",
          "per": 1000,
          "amount_micro": 1500
        },
        "agreement": null,
        "events": [
          {
            "meter": "tokens_out",
            "quantity": 4210
          }
        ],
        "expect_charge_micro": 0,
        "why": "no agreement matching the digest current at the event's ts: a recorded fact, never a retroactive bill - enforcement should have refused, rating not charging is the second wall"
      }
    ]
